{
  "name": "@tesera/sdk",
  "version": "0.0.1",
  "description": "Tesera SDK — typed client and transports (in-process / HTTP) for the Tesera ERP engine.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tesera/core": "workspace:*"
  }
}
